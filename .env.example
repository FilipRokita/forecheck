# Application configuration. Copy to .env and fill in the values.
#
# Locally only DATABASE_URL matters, and it already points at the database the
# dev container creates. On a host, set the same names in the host's
# environment variables. Each variable notes what changes there.

# --- Required ---------------------------------------------------------------

# Database connection string (SQLAlchemy URL, psycopg 3 driver).
# Local: the dev container creates the database.
# On a host: the POOLED connection string from your database provider, with
# the scheme rewritten to postgresql+psycopg:// if it says postgres:// or
# postgresql://. The app already handles that rewrite, so you can paste it as is.
DATABASE_URL=postgresql://forecheck:forecheck@localhost:5432/forecheck

# --- Only on a host ---------------------------------------------------------

# Direct (unpooled) connection string, used only by migrations.
# Local: leave it empty and migrations use DATABASE_URL.
DIRECT_URL=

# Protects the scheduled collection route. Vercel sends it as a bearer token.
# Generate with: openssl rand -base64 32
# Local: any value works. Leaving it empty disables the route.
CRON_SECRET=

# --- Optional ---------------------------------------------------------------

# Where the browser reaches the API. Leave empty: the Next.js app and the API
# share one origin (/api/...), and in development next.config.ts rewrites
# /api/* to the local API server.
NEXT_PUBLIC_API_BASE_URL=

# Where the dev server proxies /api/*. Local only.
API_PROXY_TARGET=http://127.0.0.1:8000

# A contact address sent in the User-Agent of requests to Open-Meteo and IMGW,
# so the providers can reach you if the app misbehaves. Strongly recommended.
CONTACT_EMAIL=
