  "info": {
    "description": "\nHow far can you trust a weather forecast? Open-Meteo models (ICON, ECMWF, GFS) are scored against\nIMGW station measurements. Read-only. Data: Open-Meteo.com (CC BY 4.0), IMGW-PIB (processed).\n",
    "title": "Forecheck API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/comparison": {
      "get": {
        "operationId": "comparison",
        "parameters": [
          {
            "description": "What to look at.",
            "in": "query",
            "name": "variable",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variable",
              "description": "What to look at."
            }
          },
          {
            "description": "How far back to look, from the latest scored day.",
            "in": "query",
            "name": "period",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Period",
              "description": "How far back to look, from the latest scored day."
            }
          },
          {
            "description": "Days ahead.",
            "in": "query",
            "name": "lead_days",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Days ahead.",
              "maximum": 7,
              "minimum": 1,
              "title": "Lead Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Comparison",
        "tags": [
          "scores"
        ]
      }
    },
