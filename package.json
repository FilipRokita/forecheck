{
  "name": "forecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,green \"next dev\" \"npm run dev:api\"",
    "dev:api": "uv run uvicorn api.index:app --reload --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "api:types": "uv run python scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json -o src/lib/api/schema.ts",
    "api:types:check": "npm run api:types && git diff --exit-code -- openapi.json src/lib/api/schema.ts",
    "db:migrate": "bash scripts/migrate.sh",
    "check:py": "uv run ruff check . && uv run ruff format --check . && uv run mypy && PYTHONPATH=backend uv run lint-imports && uv run pytest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
